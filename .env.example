# Reference only: this project does not load .env automatically (no python-dotenv).
# Set these variables in your environment before running the PostgreSQL helper
# scripts (init_db.py, dummy_data.py, conn_test.py, new_staff.py).
#
# Copy to .env if you keep local values there. `.env` is gitignored: never commit
# real credentials. Values below are intentionally empty.

PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
